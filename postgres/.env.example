# Copy this file to .env (cp .env.example .env) and change the password. .env is never committed or shared.
# Docker Compose reads POSTGRES_PASSWORD from here; Python reads DATABASE_URL (set it in your terminal, see README.md).
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://mgit:change-me-local-only@localhost:5432/energy
